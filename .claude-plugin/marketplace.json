{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "devdigest-plugins",
  "description": "DevDigest plugins for Claude Code: skills, agents, commands and hooks for AI-assisted code review workflows",
  "version": "0.1.0",
  "owner": {
