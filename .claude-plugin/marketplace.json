      "repository": "https://github.com/mcmaxwell/devdigest-plugins",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "agent",
        "architecture",
        "review",
        "boundaries",
        "onion-architecture",
        "dependency-cruiser"
