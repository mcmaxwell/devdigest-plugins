      "name": "architecture-reviewer",
      "displayName": "Architecture Reviewer",
      "description": "Read-only architecture review of a change: arch-evidence runs the project's mechanical boundary checks and architecture-reviewer judges the result against the boundaries the project writes down, with path:line evidence.",
      "version": "0.1.0",
      "author": {
        "name": "mcmaxwell",
        "url": "https://github.com/mcmaxwell"
      },
      "source": "./plugins/architecture-reviewer",
