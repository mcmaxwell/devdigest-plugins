---
// Home = search page (the spec rejects a marketing hero). The island searches; the static list below serves no-JS visitors and is hidden once the index loads.
import Base from '../layouts/Base.astro';
import Search from '../components/Search';
import { Card } from '../components/Card';
import { CATALOG, RECORDS, BASE } from '../lib/catalog';
import { DICTS, t } from '../i18n';
const list = [...RECORDS].sort((a, b) => a.displayName.localeCompare(b.displayName));
---
<Base title={t('catalogue')} current="catalogue">
  <div class="wrap">
    <h1 data-t="title">{t('title')}</h1>
    <p class="text-muted" style="max-width:70ch;margin-bottom:var(--space-4)" data-t="subtitle">{t('subtitle')}</p>
    <Search client:load base={BASE} repo={CATALOG.repo} commit={CATALOG.commit} />
    <section id="static-list" style="margin-top:var(--space-6)">
      <div class="results-bar"><div style="opacity:.65"><span class="tnum">{list.length}</span> <span data-t="results">{t('results')}</span></div></div>
      <div class="grid-cards">{list.map((r) => <Card r={r} base={BASE} t={DICTS.en} />)}</div>
    </section>
  </div>
</Base>
