---
import Base from '../../layouts/Base.astro';
import { CATALOG, url } from '../../lib/catalog';
import { t } from '../../i18n';
---
<Base title={t('collections')} current="collections" description={t('collectionsIntro')}>
  <div class="wrap">
    <h1 data-t="collections">{t('collections')}</h1>
    <p class="text-muted" style="margin-bottom:var(--space-6)" data-t="collectionsIntro">{t('collectionsIntro')}</p>
    <div class="grid-cards">
      {CATALOG.collections.map((c) => (
        <a href={url(`collections/${c.slug}/`)} class="card" style="text-decoration:none;color:inherit">
          <span class="card-kicker">{c.plugins.length} <span data-t="pluginsWord">{t('pluginsWord')}</span></span>
          <span class="card-title" style="font-size:24px">{c.title}</span>
          <span class="card-body">{c.description}</span>
          <span class="card-meta">{c.plugins.join(' · ')}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
