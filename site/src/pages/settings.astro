---
import Base from '../layouts/Base.astro';
import SettingsGenerator from '../components/SettingsGenerator';
import { CATALOG, PLUGINS } from '../lib/catalog';
import { t } from '../i18n';
const plugins = PLUGINS.map((p) => ({ name: p.name, displayName: p.displayName, description: p.description, stale: p.health.stale, lastChanged: p.lastChanged }));
---
<Base title={t('settings')} current="settings" description={t('selectPlugins')}>
  <div class="wrap">
    <h1 data-t="settings">{t('settings')}</h1>
    <p class="text-muted" style="max-width:70ch;margin-bottom:var(--space-6)" data-t="selectPlugins">{t('selectPlugins')}</p>
    <SettingsGenerator client:load plugins={plugins} marketplace={CATALOG.marketplace} repo={CATALOG.repo} />
  </div>
</Base>
